<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="SIM_Plant" Id="{fd05fa55-ef7f-4ba0-8738-94206af72d33}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM SIM_Plant
//==================================================================
// PLANT SIMULATOR - drives the GVL_IO *inputs* from the GVL_IO outputs
// so the aligned sequence can run without hardware. Stroke/valve times
// are set INSIDE the watchdog limits (T2/T3/T4/T6) so a clean demo
// never faults. Set bSimEnable := FALSE for real I/O.
//
// bSimEnable is the ONE switch: it is what the 'SIM VALUES / REAL
// VALUES' button on the spray screen toggles, and it covers every
// process input at once (level, pressures, pump speed feedback, valve
// traffic-light, piston sensors, mold-at-height, mother handshake).
// On the falling
// edge the simulated values are dropped rather than left latched -
// see the release block at the top of the implementation.
//==================================================================
VAR
    bSimEnable       : BOOL := TRUE;     // master enable (HMI: 'SIM VALUES' button)
    bSimAutoStart    : BOOL := FALSE;    // TRUE = kick the machine into AUTO once (demo).
                                         // Default FALSE: boots in MANUAL, as specified.
	ftSimOff        : F_TRIG;         // SIM -> REAL edge (release the sim values)
    fSimLevel       : REAL := 20.0;   // simulated level [%]
    fSimRate        : REAL := 5.0;    // rate of change [% per second]
    bSimUp          : BOOL := TRUE;   // TRUE = filling, FALSE = draining
	bAutoKicked 	: BOOL;
    tLast           : TIME;
    fDt             : REAL;

    // ---- simulated mechanical times (must stay < the matching watchdog) ----
    tSimPistonStroke : TIME := T#2S;     // piston travel  (< T3 / T4 = 3 s)
    tSimValveStroke  : TIME := T#300MS;  // SPX valve open/close (< T2 / T6 = 0.5 s)
    tSimMoldMove     : TIME := T#1S;     // mother moves mold to spray height (< T1 = 4 s)
    tSimStartGap     : TIME := T#2S;     // settle time before the demo auto-kick

    // ---- simulated VFD speed feedback ----
    rSimPumpLag      : REAL := 0.15;  // per-scan approach factor -> spin-up/down
    rSimPumpZero     : REAL := 0.5;   // [Hz] snap the lag tail to 0 below this.
                                      // Keep at/below PRG_Spray.rPUMP_RUN_MIN, the
                                      // threshold the mimic calls 'stopped'.

    // ---- timers ----
    tonPOpen   : TON;
    tonPClose  : TON;
    tonSPXO    : TON;
    tonSPXC    : TON;
    tonMold    : TON;
    tonStart   : TON;
    rtStartGap : R_TRIG;
    
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//------------------------------------------------------------------
// Simulation off -> leave every input to the real I/O.
//   On the SIM -> REAL edge the values this program was writing are
//   cleared. Without that they stay latched at their last simulated
//   figure and keep reading like live measurements - the piston lamps
//   stay green, SPX still shows 1.72 bar - which is exactly the trap
//   the sim/real button exists to prevent. Zeroed inputs make an
//   unmapped or dead channel obvious immediately (and, in AUTO, the
//   existing watchdogs fault the cycle instead of running blind).
//------------------------------------------------------------------
ftSimOff(CLK := bSimEnable);

IF NOT bSimEnable THEN
    IF ftSimOff.Q THEN
        GVL_IO.rSPXPressure     := 0.0;
        GVL_IO.rAirPressure     := 0.0;
        GVL_IO.rPumpHzFb        := 0.0;
        GVL_IO.bSPXFullyOpen    := FALSE;
        GVL_IO.bSPXFullyClose   := FALSE;
        GVL_IO.bPistonOpen      := FALSE;
        GVL_IO.bPistonClosed    := FALSE;
        GVL_IO.bMoldAtSprayHigh := FALSE;
        GVL_IO.bSprayFeasible   := FALSE;
        GVL_IO.bAutoToggleHW    := FALSE;
        // rSPXLevel is not cleared here: MAIN scales it from the real
        // iSPXLevelRaw channel every scan as soon as sim is off.
    END_IF
    RETURN;
END_IF

//------------------------------------------------------------------
// Mother handshake: mother is always ready in the demo, so each time
// the cycle returns to idle it hands control over again (cycles loop).
//------------------------------------------------------------------
GVL_IO.bSprayFeasible := TRUE;

//------------------------------------------------------------------
// Piston position sensors (P-close / P-open) follow the solenoids.
//   leaving an end clears that end immediately; reaching the far end
//   takes tSimPistonStroke.
//------------------------------------------------------------------
tonPOpen (IN := GVL_IO.bPistonOpenSol,  PT := tSimPistonStroke);
tonPClose(IN := GVL_IO.bPistonCloseSol, PT := tSimPistonStroke);

IF GVL_IO.bPistonOpenSol THEN
    GVL_IO.bPistonClosed := FALSE;
    GVL_IO.bPistonOpen   := tonPOpen.Q;
ELSIF GVL_IO.bPistonCloseSol THEN
    GVL_IO.bPistonOpen   := FALSE;
    GVL_IO.bPistonClosed := tonPClose.Q;
END_IF

//------------------------------------------------------------------
// SPX valve traffic-light follows the SPX valve command.
//------------------------------------------------------------------
tonSPXO(IN := GVL_IO.bSPXValve,     PT := tSimValveStroke);
tonSPXC(IN := NOT GVL_IO.bSPXValve, PT := tSimValveStroke);

IF GVL_IO.bSPXValve THEN
    GVL_IO.bSPXFullyClose := FALSE;
    GVL_IO.bSPXFullyOpen  := tonSPXO.Q;
ELSE
    GVL_IO.bSPXFullyOpen  := FALSE;
    GVL_IO.bSPXFullyClose := tonSPXC.Q;
END_IF

//------------------------------------------------------------------
// Mold reaches spray height shortly after we take control (busy).
//------------------------------------------------------------------
tonMold(IN := GVL_IO.bSprayBusy, PT := tSimMoldMove);
GVL_IO.bMoldAtSprayHigh := tonMold.Q;

//------------------------------------------------------------------
// Analog inputs.  Level mid-range (no level warnings); SPX pressure
// eases toward ~1.72 bar while spraying (within tolerance of 1.70).
//------------------------------------------------------------------

IF GVL_IO.bSPXValve THEN
    GVL_IO.rSPXPressure := GVL_IO.rSPXPressure + (1.72 - GVL_IO.rSPXPressure) * 0.3;
ELSE
    GVL_IO.rSPXPressure := GVL_IO.rSPXPressure + (1.50 - GVL_IO.rSPXPressure) * 0.1;
END_IF

IF GVL_IO.bAirValve THEN
    GVL_IO.rAirPressure := GVL_IO.rAirPressure + (28.0 - GVL_IO.rAirPressure) * 0.3;
ELSE
    GVL_IO.rAirPressure := GVL_IO.rAirPressure + (5.0 - GVL_IO.rAirPressure) * 0.1;
END_IF

//------------------------------------------------------------------
// Gear-pump speed feedback: first-order lag toward the VFD setpoint,
// i.e. spin-up and spin-down instead of an instant jump. The setpoint
// read here is the one written LAST scan (PRG_Process / PRG_Spray both
// run after this program), which is the right way round - a real drive
// reports where it has got to, not where it was just told to go.
// Snapped to exactly 0 below the run threshold: the lag is asymptotic,
// and a stopped pump must read zero rather than leave a tail that
// keeps the mimic circle green forever.
//------------------------------------------------------------------
GVL_IO.rPumpHzFb := GVL_IO.rPumpHzFb + (GVL_IO.rPumpHz - GVL_IO.rPumpHzFb) * rSimPumpLag;
IF GVL_IO.rPumpHz <= 0.0 AND GVL_IO.rPumpHzFb < rSimPumpZero THEN
    GVL_IO.rPumpHzFb := 0.0;
END_IF

//------------------------------------------------------------------
// Demo kick-off: pulse the AUTO toggle ONCE after boot (if enabled).
// Cycles then loop on their own (machine stays armed in AUTO), so we
// must NOT pulse again - a second pulse would disarm AUTO.
//------------------------------------------------------------------
tonStart(IN := bSimAutoStart AND NOT bAutoKicked AND (MAIN.eState = E_SeqState.eIdle),
         PT := tSimStartGap);
rtStartGap(CLK := tonStart.Q);
GVL_IO.bAutoToggleHW := rtStartGap.Q;
IF rtStartGap.Q THEN
    bAutoKicked := TRUE;
END_IF

fDt   := TIME_TO_REAL(TIME() - tLast) / 1000.0;
tLast := TIME();
fDt   := LIMIT(0.0, fDt, 0.1);   // guard against the first-cycle jump

// Level ramp - unconditional while simulating, like every other value
// this program drives. (There used to be a bSimLevelActive sub-flag
// that could hold the level on the real channel while the rest of the
// screen was simulated; with bSimEnable on the HMI it was a second,
// unreachable switch that silently froze the level. One switch only.)
IF bSimUp THEN
    fSimLevel := fSimLevel + fSimRate * fDt;
    IF fSimLevel >= 90.0 THEN
        fSimLevel := 90.0;
        bSimUp    := FALSE;      // top reached -> drain
    END_IF
ELSE
    fSimLevel := fSimLevel - fSimRate * fDt;
    IF fSimLevel <= 21.0 THEN
        fSimLevel := 21.0;
        bSimUp    := TRUE;       // bottom reached -> fill
    END_IF
END_IF
GVL_IO.rSPXLevel := fSimLevel;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>