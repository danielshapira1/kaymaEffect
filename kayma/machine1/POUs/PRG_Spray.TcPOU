<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_Spray" Id="{7e3a9c14-5b62-4d08-9f1a-2c6e8b4d3a05}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Spray
//==================================================================
// SPRAY SYSTEM SCREEN  (page 0)
//   The mimic view from the spec (slide 12). Merges the three old
//   spray programs (process view + manual + live readouts) into one
//   schematic screen:
//     - valve states by colour: green = open, grey = closed,
//       red = in transit (SPX by traffic-light, circulation = inverse,
//       air by command)
//     - piston lamps (green at a known end), mold-at-height lamp,
//       spray marks, pump Hz, SPX level, SPX/Air pressures
//     - manual buttons (live only in manual); mode colour
//       yellow = manual, green = auto
//     - CLEAN MODE (manual only): drain tank -> close drain / add
//       water prompts -> refill to 20% -> 20 s delay -> auto-open
//       the SPX valve to flush the pipes (section 6b)
//   The sequence engine stays in MAIN; this program is the HMI face.
//==================================================================
VAR_OUTPUT
    // ---- operator commands consumed by MAIN ----
    bCmdAuto  : BOOL;    // AUTO/MANUAL toggle button (tap = pulse)
    bCmdReset : BOOL;    // "Reset fault" button

    // ---- manual mode (consumed by MAIN while idle) ----
    bManualActive   : BOOL;   // TRUE = manual commands drive the outputs
    bManAirValve    : BOOL;   // manual: air valve        (HMI toggle)
    bManSPXValve    : BOOL;   // manual: SPX valve         (HMI toggle)
    bManPistonOpen  : BOOL;   // manual: piston OPEN  sol. (HMI toggle)
    bManPistonClose : BOOL;   // manual: piston CLOSE sol. (HMI toggle)
    rManPumpHz      : REAL := 15.0;   // manual/clean pump speed [Hz] - mirrors GVL_Param.rPumpSpeedBase every scan

    // ---- clean mode (read by MAIN) ----
    bCleanActive    : BOOL;   // TRUE = clean sequence running: MAIN skips the
                              // level-LOW fault and refuses to arm AUTO
    bPostCleanEmpty : BOOL;   // TRUE = clean ended with a dry tank: keep the
                              // level-LOW fault suppressed until refilled >5%
END_VAR

VAR
	
 	// ---- readout text colours (AARRGGBB) ----
    //   black = normal, amber = warning, red = lockout. Driven from the flags
    //   PRG_Process/MAIN already evaluate, so the colour on screen can never
    //   disagree with the fault code or the log file.
    cSPXPress   : DWORD;   // SPX pressure field. Amber while GVL_Process.bWarnBadSPX,
                           // i.e. the last cycle's T3/T4 average sat further than
                           // rSPXPressTol from rSPXPressureTarget. Latched per cycle,
                           // so it describes the last spray, not the live number.
    cLevel      : DWORD;   // SPX level field. Amber below rLevelLow or above
                           // rLevelHigh, red below rLevelEmpty (bLevelEmpty, which
                           // also stops the pump and blocks the mother release).
    // ---- mimic colours (AARRGGBB) ----
    cAirValve   : DWORD;
    cSPXValve   : DWORD;
    cCircValve  : DWORD;
    cPistonOpen : DWORD;
    cPistonClose: DWORD;
    cModeColor  : DWORD;

    // ---- lamps / flags ----
    bMoldLamp   : BOOL;   // mold at spray height
    bSprayMarks : BOOL;   // spray marks visible
    bFault      : BOOL;

    // ---- text ----
    sStateText  : STRING;
    sModeText   : STRING;
    sErrorText  : STRING;
    sWarnText   : STRING;

    // ---- live readouts mirrored for the HMI ----
    rPumpHz      : REAL;
    rSPXLevel    : REAL;
    rSPXPressure : REAL;
    rAirPressure : REAL;

    // ---- clean mode: HMI buttons (Toggle inputs; consumed in section 7) ----
    bBtnClean      : BOOL;   // 'CLEAN MODE' / 'STOP CLEAN' button
    bBtnStartClean : BOOL;   // 'Start Clean' button
    bBtnCloseDrain : BOOL;   // 'Close Drain' acknowledge button
    bBtnAddWater   : BOOL;   // 'Add Water'  acknowledge button

    // ---- clean mode: state + HMI feedback ----
    nCleanStep     : INT;    // nCLEAN_* constants below
    bDrainAck      : BOOL;   // operator confirmed the drain is closed
    bWaterAck      : BOOL;   // operator confirmed water is being added
    bDrainFlash    : BOOL;   // bind to 'Close Drain' toggle-colour -> flashes
    bWaterFlash    : BOOL;   // bind to 'Add Water'  toggle-colour -> flashes
    sCleanBtnText  : STRING := 'CLEAN MODE';  // 'CLEAN MODE' <-> 'STOP CLEAN'
    sCleanStatus   : STRING; // one-line operator guidance + countdown
    nFlushSecsLeft : INT;    // countdown [s] before the SPX valve auto-opens

    tonFlush       : TON;    // delay before the flush (tFLUSH_DELAY)
    tonBlink       : TON;    // 0.5 s blink generator for the flashing buttons
    bBlinkPhase    : BOOL;
    bCleanPrev     : BOOL;   // clean-active on the previous scan (exit edge)

    i : INT;
	
	 // ---- water animation (spray strokes + clean flush) ----
    bWaterFlow : BOOL;                   // TRUE = stream visible
    abDrop     : ARRAY[0..3] OF BOOL;    // one flag per droplet, top -> bottom
    nDropIdx   : INT;                    // chaser position
    tonDrop    : TON;
    j          : INT;
END_VAR

VAR CONSTANT
    cGREEN  : DWORD := 16#FF46A758;   // open / auto / OK
    cGREY   : DWORD := 16#FF8A8F98;   // closed
    cRED    : DWORD := 16#FFE5484D;   // in transit / fault
    cYELLOW : DWORD := 16#FFF2C94C;   // manual
	cBLACK  : DWORD := 16#FF000000;

    // ---- clean-mode steps ----
    nCLEAN_OFF       : INT := 0;   // clean mode not active
    nCLEAN_READY     : INT := 1;   // entered clean; waiting for Start Clean
    nCLEAN_DRAIN     : INT := 2;   // pump runs until the tank reads ~0 %
    nCLEAN_ACK       : INT := 3;   // pump off; Close Drain + Add Water flash
    nCLEAN_REFILL    : INT := 4;   // acks done; wait level >= 20 % + Start Clean
    nCLEAN_FLUSHWAIT : INT := 5;   // 20 s countdown, then SPX auto-opens
    nCLEAN_FLUSH     : INT := 6;   // SPX open, pump flushes the pipes

    rCLEAN_EMPTY : REAL := 0.5;    // 'tank is 0' threshold [%]
    rCLEAN_FILL  : REAL := 20.0;   // refill minimum [%] - flush allowed at or above this
    tFLUSH_DELAY : TIME := T#20S;  // wait before the SPX valve auto-opens
	
	nDROP_COUNT : INT  := 6;         // droplets in the column (= abDrop size)
    nDROP_LIT   : INT  := 3;         // lit at once = visible stream length
    tDROP_STEP  : TIME := T#100MS;   // time per step -> fall speed
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//==================================================================
// 1) NAV + STATE/ERROR TEXT
//==================================================================
FOR i := 0 TO 1 DO
    GVL_Nav.abNavActive[i] := (GVL_Nav.nPage = i);   // 0 = Spray, 1 = Machine Parameters
END_FOR

bFault := (MAIN.eState = E_SeqState.eFault) OR (MAIN.nErrorCode > 0);

CASE MAIN.eState OF
    E_SeqState.eIdle:         sStateText := 'Idle / circulation';
    E_SeqState.eDewater:      sStateText := 'T1 - dewater';
    E_SeqState.eSprayOpen:    sStateText := 'Spray - opening';
    E_SeqState.eSprayClose:   sStateText := 'Spray - closing';
    E_SeqState.eCloseDewater: sStateText := 'T5 - dewater / close';
ELSE
    sStateText := 'Fault';
END_CASE

CASE MAIN.nErrorCode OF
    0:  sErrorText := 'No fault';
    10: sErrorText := 'Piston not at P-close';
    20: sErrorText := 'SPX valve stuck (open)';
    21: sErrorText := 'SPX valve stuck (close)';
    30: sErrorText := 'Piston open timeout';
    40: sErrorText := 'Piston close timeout';
	50: sErrorText := 'SPX level high (>95%)';
	51: sErrorText := 'SPX level low (<5%)';
    99: sErrorText := 'Unknown state';
ELSE
    sErrorText := 'Fault';
END_CASE

// non-latching warnings (most relevant one)
IF GVL_Process.bLevelEmpty THEN
    sWarnText := 'SPX TANK EMPTY - pump off, mother held';
ELSIF GVL_Process.bWarnLevelLow THEN
    sWarnText := 'SPX level low (<20%)';
ELSIF GVL_Process.bWarnLevelHigh THEN
    sWarnText := 'SPX level high (>95%)';
ELSIF GVL_Process.bWarnBadSPX THEN
    sWarnText := 'Bad SPX pressure';
ELSIF GVL_Process.bWarnCircPress THEN
    sWarnText := 'Adjust circulation pressure';
ELSE
    sWarnText := '';
END_IF

//==================================================================
// 2) VALVE COLOURS   green = open, grey = closed, red = in transit
//==================================================================
// SPX valve - by the traffic-light feedback
IF GVL_IO.bSPXFullyOpen THEN
    cSPXValve := cGREEN;
ELSIF GVL_IO.bSPXFullyClose THEN
    cSPXValve := cGREY;
ELSE
    cSPXValve := cRED;                 // neither end -> moving
END_IF

// Circulation valve - the inverse of SPX
IF GVL_IO.bSPXFullyClose THEN
    cCircValve := cGREEN;              // SPX closed  -> circulation open
ELSIF GVL_IO.bSPXFullyOpen THEN
    cCircValve := cGREY;              // SPX open    -> circulation closed
ELSE
    cCircValve := cRED;
END_IF

// Air valve - by command (solenoid, no feedback)
IF GVL_IO.bAirValve THEN cAirValve := cGREEN; ELSE cAirValve := cGREY; END_IF

//==================================================================
// 3) PISTON LAMPS + MOLD LAMP + SPRAY MARKS
//==================================================================
IF GVL_IO.bPistonOpen  THEN cPistonOpen  := cGREEN; ELSE cPistonOpen  := cGREY; END_IF
IF GVL_IO.bPistonClosed THEN cPistonClose := cGREEN; ELSE cPistonClose := cGREY; END_IF

bMoldLamp := GVL_IO.bMoldAtSprayHigh;

// spray marks: piston off BOTH ends AND SPX + Air valves open
bSprayMarks := (NOT GVL_IO.bPistonOpen) AND (NOT GVL_IO.bPistonClosed)
            AND GVL_IO.bSPXValve AND GVL_IO.bAirValve;
			
//==================================================================
// 3b) WATER ANIMATION under the piston
//   Visible during the spray strokes (steps 20 / 30) and while the
//   clean sequence is flushing the pipes. nDropY repeats 0..spacing;
//   droplets placed one spacing apart read as a continuous stream.
//==================================================================
bWaterFlow := (MAIN.eState = E_SeqState.eSprayOpen)     // step 20
           OR (MAIN.eState = E_SeqState.eSprayClose)    // step 30
           OR (nCleanStep = nCLEAN_FLUSH);              // clean-mode flush

tonDrop(IN := bWaterFlow AND NOT tonDrop.Q, PT := tDROP_STEP);
IF NOT bWaterFlow THEN
    nDropIdx := 0;                       // always restart at the top
ELSIF tonDrop.Q THEN
    nDropIdx := (nDropIdx + 1) MOD nDROP_COUNT;
END_IF

FOR j := 0 TO nDROP_COUNT - 1 DO
    abDrop[j] := bWaterFlow
             AND (((j - nDropIdx + nDROP_COUNT) MOD nDROP_COUNT) < nDROP_LIT);
END_FOR

//==================================================================
// 4) MODE COLOUR / TEXT   manual = yellow, auto = green, fault = red
//==================================================================
IF bFault THEN
    cModeColor := cRED;    sModeText := 'FAULT';
ELSIF MAIN.bAutoMode THEN
    cModeColor := cGREEN;  sModeText := 'AUTO';
ELSE
    cModeColor := cYELLOW; sModeText := 'MANUAL';
END_IF

//------------------------------------------------------------------
// Readout colours - reuse the flags PRG_Process/MAIN already evaluate
//------------------------------------------------------------------
IF GVL_Process.bLevelEmpty THEN
    cLevel := cRED;                       // < rLevelEmpty -> pump stop / lockout
ELSIF GVL_Process.bWarnLevelLow OR GVL_Process.bWarnLevelHigh THEN
    cLevel := cYELLOW;
ELSE
    cLevel := cBLACK;
END_IF

IF GVL_Process.bWarnBadSPX THEN
    cSPXPress := cYELLOW;                 // last cycle's T3/T4 average off target
ELSE
    cSPXPress := cBLACK;
END_IF

//==================================================================
// 5) LIVE READOUTS
//==================================================================
rPumpHz      := GVL_IO.rPumpHz;
rSPXLevel    := GVL_IO.rSPXLevel;
rSPXPressure := GVL_IO.rSPXPressure;
rAirPressure := GVL_IO.rAirPressure;

//==================================================================
// 6) MANUAL MODE
//   Live only when AUTO is off and the sequence is idle. Buttons
//   toggle each actuator; MAIN applies bMan* while bManualActive.
//   While CLEAN MODE runs, the clean sequence (6b) owns the pump.
//   The pump follows the 'Pump speed' machine parameter
//   (GVL_Param.rPumpSpeedBase), so an Apply on the Params page takes
//   effect immediately here and in clean mode (6b).
//==================================================================
// mirror the machine parameter every scan - rManPumpHz has no HMI
// field of its own; the Params page is the single place to set it
rManPumpHz := GVL_Param.rPumpSpeedBase;

bManualActive := (NOT MAIN.bAutoMode) AND (MAIN.eState = E_SeqState.eIdle);

IF NOT bManualActive THEN
    bManAirValve    := FALSE;
    bManSPXValve    := FALSE;
    bManPistonOpen  := FALSE;
    bManPistonClose := FALSE;
ELSIF nCleanStep = nCLEAN_OFF THEN
    // manual pump setpoint drives the VFD directly (empty still wins)
    IF GVL_Process.bLevelEmpty THEN
        GVL_IO.rPumpHz := 0.0;
    ELSE
        GVL_IO.rPumpHz := rManPumpHz;
    END_IF
END_IF

//==================================================================
// 6b) CLEAN MODE   (manual only - button hidden otherwise)
//   READY:     operator opens the drain, presses Start Clean
//   DRAIN:     pump runs (empty lockout bypassed) until level ~0 %
//   ACK:       pump off; 'Close Drain' + 'Add Water' flash until
//              the operator presses each one
//   REFILL:    operator fills the tank to 20 % or more and closes
//              the fill valve; Start Clean accepted at level >= 20 %
//   FLUSHWAIT: 20 s countdown shown on the HMI...
//   FLUSH:     ...then the SPX valve is opened automatically (same
//              path as the manual SPX button) and the pump flushes
//              the spray pipes; when the tank runs dry the flush
//              stops and clean mode EXITS by itself
//   STOP CLEAN at any time stops everything and leaves clean mode.
//   NOTE: this runs AFTER PRG_Process in the task, so its rPumpHz
//   writes win the scan (same mechanism as the manual pump above).
//==================================================================
// ---- enter / stop ----
IF bBtnClean THEN
    IF nCleanStep = nCLEAN_OFF THEN
        IF bManualActive THEN
            nCleanStep := nCLEAN_READY;
            bDrainAck  := FALSE;
            bWaterAck  := FALSE;
        END_IF
    ELSE
        // STOP CLEAN - stop whatever the sequence is doing
        nCleanStep     := nCLEAN_OFF;
        bManSPXValve   := FALSE;     // close the SPX valve if flushing
        GVL_IO.rPumpHz := 0.0;       // normal manual logic resumes next scan
    END_IF
END_IF

// leaving manual (fault / sequence running) aborts clean mode
IF (nCleanStep <> nCLEAN_OFF) AND NOT bManualActive THEN
    nCleanStep     := nCLEAN_OFF;
    GVL_IO.rPumpHz := 0.0;
END_IF

bCleanActive := (nCleanStep <> nCLEAN_OFF);

// 0.5 s blink generator for the flashing prompt buttons
tonBlink(IN := NOT tonBlink.Q, PT := T#500MS);
IF tonBlink.Q THEN
    bBlinkPhase := NOT bBlinkPhase;
END_IF

CASE nCleanStep OF

    nCLEAN_OFF:
        tonFlush(IN := FALSE);
        bDrainFlash  := FALSE;
        bWaterFlash  := FALSE;
        sCleanStatus := '';

    nCLEAN_READY:
        // circulation keeps running at the manual setpoint until drain starts
        IF GVL_Process.bLevelEmpty THEN
            GVL_IO.rPumpHz := 0.0;
        ELSE
            GVL_IO.rPumpHz := rManPumpHz;
        END_IF
        sCleanStatus := 'Open the drain, then press Start Clean';
        IF bBtnStartClean THEN
            nCleanStep := nCLEAN_DRAIN;
        END_IF

    nCLEAN_DRAIN:
        // pump keeps running below the normal empty lockout - the goal IS 0 %
        GVL_IO.rPumpHz := rManPumpHz;
        sCleanStatus   := 'Draining tank...';
        IF GVL_IO.rSPXLevel <= rCLEAN_EMPTY THEN
            GVL_IO.rPumpHz := 0.0;
            bDrainAck  := FALSE;
            bWaterAck  := FALSE;
            nCleanStep := nCLEAN_ACK;
        END_IF

    nCLEAN_ACK:
        GVL_IO.rPumpHz := 0.0;
        sCleanStatus   := 'Tank empty - close the drain and add water';
        IF bBtnCloseDrain THEN bDrainAck := TRUE; END_IF
        IF bBtnAddWater  THEN bWaterAck := TRUE; END_IF
        bDrainFlash := (NOT bDrainAck) AND bBlinkPhase;
        bWaterFlash := (NOT bWaterAck) AND bBlinkPhase;
        IF bDrainAck AND bWaterAck THEN
            bDrainFlash := FALSE;
            bWaterFlash := FALSE;
            nCleanStep  := nCLEAN_REFILL;
        END_IF

    nCLEAN_REFILL:
        GVL_IO.rPumpHz := 0.0;
        IF GVL_IO.rSPXLevel >= rCLEAN_FILL THEN
            sCleanStatus := 'Ready - press Start Clean to flush the pipes';
            IF bBtnStartClean THEN
                tonFlush(IN := FALSE);           // make sure the timer restarts
                nCleanStep := nCLEAN_FLUSHWAIT;
            END_IF
        ELSE
            sCleanStatus := 'Fill the tank to 20% or more, then close the fill valve';
            // Start Clean is ignored until the tank holds at least 20 %
        END_IF

    nCLEAN_FLUSHWAIT:
        // circulate the fresh water while the countdown runs
        GVL_IO.rPumpHz := rManPumpHz;
        tonFlush(IN := TRUE, PT := tFLUSH_DELAY);
        nFlushSecsLeft := DINT_TO_INT(
            (TIME_TO_DINT(tFLUSH_DELAY) - TIME_TO_DINT(tonFlush.ET)) / 1000);
        IF nFlushSecsLeft < 0 THEN nFlushSecsLeft := 0; END_IF
        sCleanStatus := CONCAT(CONCAT('Opening SPX valve in ',
                        INT_TO_STRING(nFlushSecsLeft)), ' s');
        IF tonFlush.Q THEN
            tonFlush(IN := FALSE);
            bManSPXValve := TRUE;    // auto-'press' the manual SPX-valve button
            nCleanStep   := nCLEAN_FLUSH;
        END_IF

    nCLEAN_FLUSH:
        // pump pushes water through the open SPX line
        IF GVL_IO.rSPXLevel <= rCLEAN_EMPTY THEN
            // tank dry -> flush finished: stop and leave clean mode by itself
            GVL_IO.rPumpHz := 0.0;
            bManSPXValve   := FALSE;         // close the SPX valve
            nCleanStep     := nCLEAN_OFF;
        ELSE
            GVL_IO.rPumpHz := rManPumpHz;
            sCleanStatus   := 'Flushing pipes - press Stop Clean to finish';
        END_IF

END_CASE

//------------------------------------------------------------------
// post-clean empty latch: leaving clean mode with a dry tank (auto
// flush-complete OR Stop Clean mid-way) must not latch the level-LOW
// fault in MAIN. Suppressed until the tank is refilled above 5 %.
//------------------------------------------------------------------
IF bCleanPrev AND (nCleanStep = nCLEAN_OFF)
   AND (GVL_IO.rSPXLevel < GVL_Param.rLevelEmpty) THEN
    bPostCleanEmpty := TRUE;
END_IF
IF GVL_IO.rSPXLevel >= GVL_Param.rLevelEmpty THEN
    bPostCleanEmpty := FALSE;    // refilled -> normal protection resumes
END_IF
bCleanPrev := (nCleanStep <> nCLEAN_OFF);

// clean-button label follows the mode
IF bCleanActive THEN
    sCleanBtnText := 'STOP CLEAN';
ELSE
    sCleanBtnText := 'CLEAN MODE';
END_IF

//==================================================================
// 7) CONSUME COMMAND BITS
//   MAIN read them at the top of this scan; clearing here means the
//   HMI button only has to write TRUE once per press. The clean
//   buttons were consumed by section 6b just above.
//==================================================================
bCmdAuto  := FALSE;
bCmdReset := FALSE;
bBtnClean      := FALSE;
bBtnStartClean := FALSE;
bBtnCloseDrain := FALSE;
bBtnAddWater   := FALSE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>